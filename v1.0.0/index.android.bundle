__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={signIn:'Sign In',signUp:'Sign Up',lostYourPassword:'Lost Your Password?',continueAsGuest:'Continue as Guest',signInWithPin:'Sign in with PIN',sigInWithEmail:'Sign in with email',createAccount:'Create Account',password:'Password',newPassword:'New Password',confirmPassword:'Confirm password',prefixAgreeDescription:'By signing in, I agree to the',suffixAgreeDescription:'Regenesis Studio Terms & Conditions',username:'Username',emailAddress:'Email Address',usernameOrEmail:'Username or email',fullName:'Full Name',firstName:'First Name',lastName:'Last Name',signUpSuccessInfo:'Congratulations, your account has been successfully created, please check and confirm email',goToSignIn:'Go To Sign In',sendForgotEmail:'Reset password link has been send',pin:'Pin',yourAccount:'Your Account',enableSignInWithPin:'Enable sign in with PIN',profile:'Profile',descriptionEnableWithPinPopup:'Enable sign in with pin to easy sign in',sessionLoginExpired:'Login session expired',signInFailed:"Can't sign in",resendConfirm:'Re-Send',guestFailed:"Can't join as guest",completeYourRegistration:{title:'Complete Your Registration',description:'Your name & email was provided with your disclaimer, so if you\u2019d like to start a Users Account, all you need to do is add a password. Once signed up, your session will be logged in your account and we\u2019ll email you more insightful information about your experience.',labelCheckboxAgree:"I don't mind receiving occasional emails from Regenesis",CreateUserAccount:'Create User Account'},successResetPassword:'Reset password successfully',forgotPasswordOnlyWorkingOnlineNetwork:'Forgot password only works on online network'}},609,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={RECREATION_MODE:{text:'CREATION MODE',prefix:'RE'},description:'Connect your device and go at your own pace with \u2018Work Rest Play\u2019. You can set an idyllic tone for some music, a snooze, or to catch up on some work... or try one of our guided journeys for an even more connected experience.',workRestPlay:{title:'Work\u2022Rest\u2022Play',description:'Connect your phone or Laptop, via Bluetooth, to our Next Generation Audio System and select a mode preset to enjoy the Pod at your own pace. Simply \u2018CONNECT BLUETOOTH\u2019 below and select a preset to get started.'},guidedMediation:{title:'Guided Meditation',description:'Scroll through our selection of our mediation sessions. We recommend our \u2018Introduction to Meditation\u2019 session if you\u2019re new to Meditation. More info is available on each session by click the information \u2018i\u2019.'},guidedBreathwork:{title:'Guided Breathwork',description:'Scroll through our selection of our breathwork sessions. We recommend our \u2018Introduction to breathwork\u2019 session if you\u2019re new to Breathwork. More info is available on each session by click the information \u2018i\u2019.'},tabs:{recreationModes:'Recreation Modes',favorites:'Favorites',yourPresets:'Your Presets',sessionLibrary:'Session Library'},otp:{pairing:'pairing',disconnecting:'disconnecting',wait:'waiting for otp',connect2RegenesisAudio:'CONNECT TO REGENESIS AUDIO',disconnect:'DISCONNECT',connected:'CONNECTED',pairWithDevice:'CONNECT TO REGENESIS AUDIO',connectBT:'Connect Bluetooth'}}},610,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={title:'Session Experiences',description:'Directly select a session for a quick start or tap the Information icons for deeper insight on each session.',description2:'Qualified members may also load \u2018Saved & Preloaded\u2019 Sessions.',saveAndPreLoadedSession:"Saved & Preloaded sessions",selectSessionDuration:'Select the Session Duration',selectVoiceGuidance:'Select the Voice Guidance',confirmStartQuestion:'Are you ready to start your session?',confirmStartQuestionPrefix:'Are you ready to start',confirmStartQuestionSuffix:'session',confirmStart:'Confirm Start',sessionComplete:'The session has been completed',tapHereForMore:'Tap here for more information',weRecommend:'We recommend talking the time to ease into your session, however, if you prefer, you can skip the Intro.',skipIntro:'Skip Intro (Not recommended)',selectDuration:'Select the Session Duration',adjustTheGuidance:'Adjust the guidance level for your session, then we shall return it to your current level when the session is complete.',selectGuidanceLevel:'Select your session voice guidance level'}},611,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={title:'Resonant Energetics',subTitle:'Introducing your best self',description:'Explore Regenesis \u2018Session Mode\u2019 and embark on the ultimate inner journey, or ease into the Regenesis experience with \u2018Recreation Mode\u2019. Select Training Mode to access your customized training program designed to help you achieve your personal goals & discover your best self.',sessionModeTitle:'Session mode',prefixCreationMode:'Re',creationMode:'Creation mode',navigationTutorial:'Navigation tutorial',recommendedMinute:'Recommended - 1 Minute'}},612,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={title:'Explore session experiences',description:'Tap the Navigation Dots swipe the main screen to browser the sessions',swipePrevious:'Swipe Previous',swipeNext:'Swipe Next'}},613,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.default=void 0;e.default={title:'Disclaimer / User Agreement',agreeAndContinue:'Agree & Continue',importantContent:"Please cycle through and answer 'Yes' or 'No' to each question. Be sure to answer carefully. Your answers are required to tailor your Pod experience for your health & safety.",disclaimerPointDetail:'Disclaimer point detail',question1:'Have you or your family had any history of epilepsy or seizures?',question2:'Do you use any implanted health devices inc; Pacemakers, Hearing Aids, IUDs etc?',question3:'Do you have any psychological or psychiatric conditions?',question4:'Have you suffered any head or brain injuries or strokes in the past?',question5:'Have you taken recreational or psycho-active drugs in the past 24 hours?',question6:'Are you pregnant?',infoQuestion1:'<p style="text-align:center"><span style="color:#7a7a7a">If you answer &lsquo;YES&rsquo; to this question, for your health &amp; safety, the </span><span style="color:#7b62e7">STROBOSCOPIC LIGHT</span><span style="color:#7a7a7a"> will be disabled within any selected session that features this component. You can still enjoy the many other benefits of your selected session.</span></p>',infoQuestion2:"<p style=\"text-align:center\"><span style=\"color:#7a7a7a\">If you answer &lsquo;YES&rsquo; to this question, for your health &amp; safety, the </span><span style=\"color:#9c0091\">PEMF THERAPY</span><span style=\"color:#7a7a7a\"> will be disabled within any selected session that features this component.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">You can still enjoy the benefits of the additional components with no settings limitations.</span>&nbsp;</p>",infoQuestion3:"<p style=\"text-align:center\"><span style=\"color:#7a7a7a\">If you answer &lsquo;YES&rsquo; to this question, for your health &amp; safety, the </span><span style=\"color:#ac004a\">STROBOSCOPIC LIGHT</span><span style=\"color:#7a7a7a\"> will be disabled within any selected session that features this component.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">Your session </span><span style=\"color:#ac004a\">VOLUME</span><span style=\"color:#7a7a7a\"> &amp; </span><span style=\"color:#ac004a\">FULL BODY VIBRO-ACCOUSTICS (TRANSDUCERS)</span><span style=\"color:#7a7a7a\"> will also be reduced by 50%, however you can adjust these components to your desired settings via the manual controls.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">You can still enjoy the benefits of the additional components with no settings limitations.</span></p>\n  ",infoQuestion4:"<p style=\"text-align:center\"><span style=\"color:#7a7a7a\">If you answer &lsquo;YES&rsquo; to this question, for your health &amp; safety, the </span><span style=\"color:#cc0a00\">STROBOSCOPIC LIGHT</span><span style=\"color:#7a7a7a\"> will be disabled within any selected session that features this component.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">Your session </span><span style=\"color:#cc0a00\">VOLUME</span><span style=\"color:#7a7a7a\"> &amp; </span><span style=\"color:#cc0a00\">FULL BODY VIBRO-ACCOUSTICS (TRANSDUCERS)</span><span style=\"color:#7a7a7a\"> will also be reduced by 50%, however you can adjust these components to your desired settings via the manual controls.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">You can still enjoy the benefits of the additional components with no settings limitations.</span></p>\n  ",infoQuestion5:"<p style=\"text-align:center\"><span style=\"color:#7a7a7a\">If you answer &lsquo;YES&rsquo; to this question, for your health &amp; safety, the </span><span style=\"color:#ff4f11\">STROBOSCOPIC LIGHT</span><span style=\"color:#7a7a7a\"> will be set at &lsquo;Zero&rsquo; (0%), however you may adjust the light settings to your desired intensity via the manual controls.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">You can still enjoy the benefits of the additional components with no settings limitations.</span></p>\n  ",infoQuestion6:"<p style=\"text-align:center\"><span style=\"color:#7a7a7a\">If you answer &lsquo;YES&rsquo; to this question, for your health &amp; safety, the </span><span style=\"color:#ff7d00\">STROBOSCOPIC LIGHT</span><span style=\"color:#7a7a7a\"> will be set at &lsquo;Zero&rsquo; (0%), however you can adjust this component to your desired settings via the manual controls.</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">The </span><span style=\"color:#ff7d00\">PEMY THERAPY</span><span style=\"color:#7a7a7a\"> will also be switched off during your session, and the </span><span style=\"color:#ff7d00\">INFRA-RED (NEAR I-R)</span><span style=\"color:#7a7a7a\"> will be set to 35 Degrees (Celcius).</span></p>\n  <p style=\"text-align:center\"><span style=\"color:#7a7a7a\">You can still enjoy the benefits of the additional components with no settings limitations.</span></p>\n  ",additionalInfoQuestion:'For more information, when closing this popup, the \u2018Terms & Conditions\u2019 field will highlight the associated information section within our \u2018Health & Safety\u2019 Policy.',conditionTermsTitle:'PLEASE READ TO THE BOTTOM TO CONFIRM OUR TERMS & CONDITIONS.',conditionTermsOpening:"<p style=\"text-align:center\"><strong>Recharge Pod Ltd T/A Regenesis Studio</strong></p><p style=\"text-align:center\"><strong>Terms &amp; Conditions / User Agreement</strong></p>\n  <p>The user acknowledges they have read and understand the Terms & Conditions for using the Regenesis Pod and accepts all responsibility and liability.</p>\n  <p>Regenesis Studio's services & products are not intended to be used to diagnose, treat, cure or prevent any disease.  We do not make any medical claims, the information and opinions provided are based upon reputably published journals and our own experience. This information is never to be interpreted as medical advice.</p>\n  <p>Users should consult appropriate health professionals on any mater relating to their health & wellness.</p>\n  <p>&nbsp;</p>\n  <strong>HEALTH &amp; SAFETY POLICY:</strong><br/>",conditionTermsContentQuestion1:"\n    <p><strong><em>Have you or your family had any history of epilepsy or seizures?</em></strong></p>\n    <p>Please note that our services may include elements like flashing lights, vibrations, and sound frequencies that could potentially trigger seizures or epileptic episodes in susceptible individuals. If you or anyone in your family has a history of epilepsy or seizures, please consult a medical professional before using our services.</p>",conditionTermsContentQuestion2:"\n    <p><strong><em>Do you use any implanted health devices inc; Pacemakers, Hearing Aids, IUDs etc?</em></strong></p>\n    <p>Our products may interact with certain electronic devices, such as pacemakers or hearing aids. Please consult with your doctor if you use any implanted health devices to ensure that it is safe for you to use the Regenesis Pod.</p>",conditionTermsContentQuestion3:"\n    <p><strong><em>Do you have any psychological or psychiatric conditions?</em></strong></p>\n    <p>Our services are designed to promote relaxation and well-being. However, if you suffer from any psychological or psychiatric conditions, we strongly advise you to seek medical advice before using our products to ensure that they are suitable for you.</p>",conditionTermsContentQuestion4:"\n    <p><strong><em>Have you suffered any head or brain injuries or strokes in the past?</em></strong></p>\n    <p>Individuals who have experienced head trauma, brain injuries, or strokes should consult with their healthcare provider before using our services, as the regenerative and neurological stimuli used in our product may have varying effects depending on individual conditions.</p>\n    ",conditionTermsContentQuestion5:"\n    <p><strong><em>Have you taken recreational or psycho-active drugs in the past 24 hours?</em></strong><br /><br />\n    For your safety, we recommend that you refrain from using the Regenesis Pod if you have consumed recreational or psychoactive drugs within the past 24 hours. Such substances could interact with our services in unpredictable ways.</p>",conditionTermsContentQuestion6:"\n    <p><strong><em>Are you pregnant?</em></strong>\n    <p>If you are pregnant, please seek advice from your healthcare professional before using the Regenesis Pod. While our services are designed to promote wellness, certain technologies and frequencies may not be recommended during pregnancy.</p> \n    \n    <br />\n    <br />\n    Regenesis Studio is committed to providing quality services to you and it is important you can trust us with your personal information. We take your privacy and security very seriously. We have adopted the National Privacy Principles (NPPs) contained in the Privacy Act of 1988 (the Privacy Act). The NPPs govern the way in which we collect, use, disclose, store, secure and dispose of your Personal Information. A copy of the Australian Privacy Principles may be obtained from the website of The Office of the Federal Privacy Commissioner at <a href=\"http://www.privacy.gov.au/\" style=\"text-decoration:none\"><span><span><span style=\"color:#337ab7\">www.privacy.gov.au</span style=></span></span></a>.</p>\n    <p>IN SIGNING THIS RELEASE, I ACKNOWLEDGE AND REPRESENT THAT:</p>\n    <p>All information supplied in connection with the Service is truthful, accurate and complete and I will maintain the accuracy of such information. My Regenesis Studio Account may be deleted and access to Regenesis Studio&rsquo;s Services may be refused without notice if Regenesis Studio believes that the above is not represented or warranted.</p>\n    <p>If I have any pre-existing medical condition, am pregnant or have any concerns as to whether I should try the Services, that I have fully disclosed any concerns to Regenesis Studio, that I have consulted my doctor prior to the appointment and that I will follow the guidance of my doctor.</p>\n    <p>I understand there may be some degree of discomfort after the Services, such as, but not limited to, euphoria, deep introspection, melancholy, excitement, some physical invigoration or anxiety, but I release Regenesis Studio from any responsibility for symptoms related to the meditative effects incurred with the Services.</p>\n    <p>I agree that I will comply with all instructions given to me, both in writing, on the app, website or verbally, regarding the proper use of the equipment and that I am using these services at my own risk.</p>\n    <p>I understand the concepts of release and indemnity. I have read and understand the elements included in each session. Accordingly, I release Regenesis Studio and all persons or entities associated with Regenesis Studio (Universities, Professional sports entities, Health and Wellness entities, Meditation entities, etc.) from any claim, demand, liability, actions, right of action or proceeding which are related to, arise out of, or are in any way connected with my participation in the Services, including those allegedly attributed to the negligent acts or omissions of Regenesis Studio.</p>\n    <p>I understand that by signing this document and entering into this Agreement, and by participating in the Services, I accept, irrevocably, all risk of injury, which occurs as a result of my participation in the Services of Regenesis Studio.</p>\n    <p>I have read, understand and fully agree to the foregoing Terms and Conditions and Waiver of Liability Agreement, I am at least eighteen (18) years of age and fully competent; and I execute this Release for full, adequate, and complete consideration, fully intending to be bound by same.</p>\n    <p>I hereby give my authorisation and consent. This CONSENT shall stand as long as I use the Services at Regenesis Studio now and in the future.</p>\n    ",labelCheckboxAgree:'I agree to the Regenesis Studio terms & conditions.',titleLegalDigitalSignature:"Entering your Full Name & Email will be considered your legal digital signature. If you are satisfied that you have answered all the questions accurately, please continue.",errorFormNotComplete:'In order to Save & Continue, you must answer each 6 questions, \u2018Yes\u2019 or \u2018No\u2019. Then scroll to the base of the Terms & Conditions field and the confirmation box. Also make sure you have completed your full name & valid email address.',completeModalTitle:'Thanks for signing up & completing the user agreement',completeUpdateModalTitle:'Thanks for updating your information',completeModalSubTitle:'HELPFUL HINT:',completeModalContent:'You can review and update your Profile Information, Password, and Disclaimer / User Agreement in your General Settings & Preference area. Just look out for the settings cog icon on the Homepage',completeUpdateModalContent:'All updates will take effect immediately including any updates effecing the Pod components'}},614,[]);
